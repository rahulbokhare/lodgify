<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show page</title>
</head>
<body>
    <ul>
        <h4><%= listing.title %></h4>
        <h4><%= listing.location %></h4>
        <h4><%= listing.country %></h4>
        <h4><%= listing.price %></h4>
        <h4><%= listing.description %></h4>
    </ul>

    <a href="/home/<%= listing._id %>/edit">edit listing</a>
    <form action="/home/<%= listing._id %>?_method=delete" method="post">
        <button>delete</button>
    </form>
</body>
</html>