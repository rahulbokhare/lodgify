<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index route</title>
</head>
<body>
    <hr>
    <a href="/home/new">Create New Listing</a>
    <hr>
   <ul>
     <%for(let listing of listings){ %>
        <a href="/home/<%= listing._id %>"><li><%= listing.title %></li></a>
     <% } %>

   </ul>
</body>
</html>