


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
     <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%= errorMsg %>
   <div class="row">
     <div class="col-4 offset-4 ">
        <h3 class="mt-5">Signup</h3>
        <form action="/signup" novalidate class="needs-validation" method="post">

        <div class="row mt-4">
             <label for="username" class="form-label">Enter Username </label>
             <input type="text" class="form-control" name="username" id="username" required>
             <div class="invalid-feedback">please enter username to continue</div>
        </div>

        <div class="row">
            <label for="email" class="form-label" >Enter email  </label>
            <input type="text" name="user[email]" class="form-control" id="email" required>

        </div>

        <div class="row">
            <label for="pass" class="form-label">Enter Password </label>
            <input type="password" class="form-control" name="password" id="pass" required>
            <div class="invalid-feedback">please enter password to continue</div>
        </div>

        <button class="btn btn-success col-2 offset-4 mt-4">signup</button>

      </form>
    </div>
   </div>


   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
</body>
</html>