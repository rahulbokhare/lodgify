<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Listing</title>
</head>
<body>
    <form action="/home/new" method="post">
        <label for="title">Enter title : </label>
        <input type="text" id="title" name="listing[title]">
        <br>
        <label for="location">Enter location : </label>
        <input type="text" id="location" name="listing[location]">
        <br>
        <label for="country">Enter country : </label>
        <input type="text" id="country" name="listing[country]">
        <br>
        <label for="price">Enter price : </label>
        <input type="text" id="price" name="listing[price]" placeholder="Enter Price">
        <br>
        <label for="desc">Enter description : </label>
        <textarea name="listing[description]" id="desc"> </textarea>

        <button>submit</button>
    </form>
</body>
</html>