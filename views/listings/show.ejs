<% layout("layouts/boilerplate") %>
    <%= errorMsg %>
    <div class="show">
        <div class="show-img">
             <img src="<%= listing.image.url %>" alt="">
        </div>
        <div class="show-details">
            <h2 class="mt-3"><%= listing.title %></h2>
            <p>owned by : <%= listing.owner.username %></p>
            <p>Location : <%= listing.location %></p>
            <p>Country : <%= listing.country %></p>
            <p>Price : <%= listing.price %></p>
            <p><%= listing.description %></p>
        </div>

        <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                    <div class="col-8 offset-2 d-flex">
                        <a href="/home/<%= listing._id %>/edit" class="btn btn-success col-1">edit </a>
                        <form action="/home/<%= listing._id %>?_method=delete"  method="post">
                            <button class="btn btn-danger offset-4 ">delete</button>
                        </form>
                    </div>
        <% } %>

    </div>
        

    
  <div class="review-form">
      <h2>Review Here</h2>
     <form action="/home/<%= listing._id %>/review" method="post">
        <label for="review">Reveiw : </label>
        <textarea name="review[comment]" id="review"></textarea>
        <button class="btn btn-success">submit</button>
    </form>
  </div>

    <div class="reviews">
        <div class="review-container">
             <% for(review of listing.reviews) { %>
                <div class="review">
                    <p id="username""><%= review.author.username %></p>
                    <p id="comment"><%= review.comment %></p>
                </div>  
            <% } %>   
        </div>
        
    </div>

