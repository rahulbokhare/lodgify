<% layout("layouts/boilerplate") %>
<%= successMsg %>
<div class="container">  
    <%for(let listing of listings){ %>
      <a href="/home/<%= listing._id %>">
        <div class="card">
          <div class="card-img">
              <img style="width: 100%; height: 100%; overflow: hidden;" src="<%= listing.image.url %>" alt="">
          </div>
          <div class="card-details">
            <div class="heading">
              <p><%= listing.title %></p>
              <p>owned by : <%= listing.owner.username %></p>
            </div>
            <p><%= listing.location %></p>
            <p><%= listing.price %></p>
          </div>
        </div>
      </a>
    <% } %>  
</div>