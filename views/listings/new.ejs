<% layout("layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3 class="mt-3">Create New Listing Here</h3>

            <form action="/home/new" novalidate class="needs-validation" enctype="multipart/form-data" method="post">
                <div class="row mb-3">
                    <label for="title" class="form-label">Enter title  </label>
                    <input type="text" id="title" class="form-control" name="listing[title]" required>
                    <div class="invalid-feedback">title must be entered</div>
                    <div class="valid-feedback">nice title</div>
                </div>
                
                <div class="row">
                    <div class="col-4 mb-3">
                         <label for="price" class="form-label">Enter price </label>
                         <input type="text" id="price" class="form-control" name="listing[price]" placeholder="Enter Price" required>
                         <div class="invalid-feedback">enter price to continue</div>
                         <div class="valid-feedback">good price</div>
                    </div>

                    <div class="col-8 mb-3">
                        <label for="country" class="form-label">Enter country </label>
                        <input type="text" id="country" class="form-control" name="listing[country]" required>
                        <div class="invalid-feedback">enter country to continue</div>
                        <div class="valid-feedback">woww nice country</div>
                     </div>

                </div>

                <div class="row mb-4">
                    <label for="location" class="form-label">Enter location  </label>
                    <input type="text" id="location" class="form-control" name="listing[location]" required>
                    <div class="invalid-feedback">enter location to continue</div>
                    <div class="valid-feedback">nice location</div>
                </div>

                <div class="row mb-4">
                    <label for="desc" class="form-label">Enter description  </label>
                    <textarea name="listing[description]" class="form-control" id="desc" required></textarea>
                    <div class="invalid-feedback">enter description to continue</div>
                    <div class="valid-feedback">nice description</div>
                </div>

                <div class="row mb-4">
                    <label for="image" class="form-label">upload image  </label>
                    <input type="file" name="listing[image]" class="form-control"  id="image"></input>
                    <div class="invalid-feedback">upload image  to continue</div>
                    <div class="valid-feedback">great you've uploaded image</div>
                </div>


                
                <div class="row ">
                    <button class="btn btn-success mt-2 col-6 offset-3" >Create</button>
                </div>
            </form>
        </div>
    </div>

